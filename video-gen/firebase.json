{
  "firestore": {
    "database": "video-gen-bb",
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "vexp-ui-bb",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "ssrvexpuibb",
          "region": "us-central1"
        }
      }
    ]
  }
}
