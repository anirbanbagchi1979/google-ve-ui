rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Read: any authenticated user (allowlist enforced at app level by AuthGate)
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }

    // Write: only to known browser upload paths
    match /videos/{filename} {
      allow write: if request.auth != null;
    }

    match /images/{filename} {
      allow write: if request.auth != null;
    }

    match /masks/{filename} {
      allow write: if request.auth != null;
    }
  }
}
